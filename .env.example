# DocNest Environment Configuration Template

# Server Settings
DOCNEST_ENV=development
DOCNEST_API_HOST=0.0.0.0
DOCNEST_API_PORT=8000
DOCNEST_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File & Vector Storage Paths
DOCNEST_DOCUMENTS_DIR=backend/documents
DOCNEST_CHROMA_DIR=backend/chroma_db
DOCNEST_COLLECTION_NAME=docnest_collection

# RAG & Embedding Hyperparameters
DOCNEST_EMBEDDING_MODEL=all-MiniLM-L6-v2
DOCNEST_CHUNK_SIZE=500
DOCNEST_CHUNK_OVERLAP=60
DOCNEST_RETRIEVAL_TOP_K=4
DOCNEST_SIMILARITY_THRESHOLD=0.35

# Ollama LLM Settings
DOCNEST_OLLAMA_BASE_URL=http://localhost:11434
DOCNEST_OLLAMA_MODEL=llama3.2
DOCNEST_OLLAMA_TIMEOUT=60

# File Upload Security Constraints
DOCNEST_MAX_FILE_SIZE_MB=50
DOCNEST_ALLOWED_EXTENSIONS=[".pdf"]
