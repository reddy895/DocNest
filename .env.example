# DocNest Environment Configuration Template

# Server Settings
DOCNEST_ENV=production
DOCNEST_API_HOST=0.0.0.0
DOCNEST_API_PORT=8000
DOCNEST_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://localhost:3000"]

# JWT Authentication
DOCNEST_JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
DOCNEST_JWT_ALGORITHM=HS256
DOCNEST_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File & Vector Storage Paths
DOCNEST_DOCUMENTS_DIR=backend/documents
DOCNEST_CHROMA_DIR=backend/chroma_db
DOCNEST_BM25_DIR=backend/bm25_index
DOCNEST_SAMPLES_DIR=backend/samples
DOCNEST_DB_PATH=backend/docnest.db
DOCNEST_COLLECTION_NAME=docnest_collection

# RAG & Embedding Hyperparameters
DOCNEST_EMBEDDING_MODEL=nomic-embed-text
DOCNEST_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DOCNEST_CHUNK_SIZE=512
DOCNEST_CHUNK_OVERLAP=64
DOCNEST_RETRIEVAL_TOP_K=5
DOCNEST_MIN_RELEVANCE_SCORE=0.30
DOCNEST_HYBRID_SEARCH_ENABLED=true
DOCNEST_RERANKER_ENABLED=true

# Ollama LLM Settings
DOCNEST_OLLAMA_BASE_URL=http://localhost:11434
DOCNEST_OLLAMA_MODEL=llama3.2
DOCNEST_OLLAMA_TIMEOUT=60

# File Upload Security Constraints
DOCNEST_MAX_FILE_SIZE_MB=50
DOCNEST_ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".md",".csv"]

# MongoDB Primary Database Integration (with auto-fallback to SQLite)
DOCNEST_MONGO_URI=mongodb://localhost:27017
DOCNEST_MONGO_DB_NAME=docnest
DOCNEST_MONGO_ENABLED=false

# Rate Limiting & Security
DOCNEST_RATE_LIMIT_PER_MINUTE=120
DOCNEST_DEFAULT_WORKSPACE="Default Research Workspace"

# Optional Cloud LLM API Keys (Ollama remains 100% local default)
DOCNEST_OPENAI_API_KEY=
DOCNEST_OPENAI_BASE_URL=

